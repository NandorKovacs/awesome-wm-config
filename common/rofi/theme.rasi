/* Shared look for all rofi menus (see init.lua), styled after the bemenu
 * emoji selector: --tf/--hf/--bdr "#7e5edc", -l 10 -c -W 0.4 -B 4,
 * --fn "Monospace 25". init.lua runs rofi with -dpi 96 so the font size
 * matches bemenu's.
 *
 * Conventions menus can rely on:
 *   - rows flagged "urgent" are drawn dimmed (e.g. muted outputs)
 *   - a message, if the menu sets one, is shown as a small hint line below */

/* Super+number is awesome's tag switching; do not let it pick rows here. */
configuration {
    kb-select-1:  "";
    kb-select-2:  "";
    kb-select-3:  "";
    kb-select-4:  "";
    kb-select-5:  "";
    kb-select-6:  "";
    kb-select-7:  "";
    kb-select-8:  "";
    kb-select-9:  "";
    kb-select-10: "";
}

* {
    accent: #7e5edc;
    bg:     #121212;
    fg:     #cacaca;
    dim:    #6b6b6b;

    font:             "Monospace 25";
    background-color: @bg;
    text-color:       @fg;
    margin:           0;
    padding:          0;
    spacing:          0;
    border:           0;
}

window {
    location:     center;
    anchor:       center;
    width:        40%;
    border:       4px;
    border-color: @accent;
    padding:      0px 8px 4px 8px;
}

mainbox {
    children: [ inputbar, listview, message ];
}

inputbar {
    children: [ prompt, entry ];
    spacing:  0.5em;
}

prompt {
    text-color: @accent;
}

listview {
    lines:        10;
    fixed-height: false;
    dynamic:      true;
    scrollbar:    false;
    cycle:        true;
    border:       0;
}

element {
    children: [ element-text ];
    border:   0;
}

element-text {
    background-color: inherit;
    text-color:       inherit;
    highlight:        none;   /* no bold/underline on the matched text, like bemenu */
}

/* every state is listed so rofi's built-in defaults cannot leak through */
element normal.normal, element alternate.normal,
element normal.active, element alternate.active {
    background-color: @bg;
    text-color:       @fg;
}

/* rows flagged urgent are dimmed */
element normal.urgent, element alternate.urgent {
    background-color: @bg;
    text-color:       @dim;
}

element selected.normal, element selected.active, element selected.urgent {
    background-color: @bg;
    text-color:       @accent;
}

message {
    border:  0;
    padding: 0;
}

textbox {
    font:       "Monospace 12";
    text-color: @dim;
}
